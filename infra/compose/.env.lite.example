# Argo lite settings for an 8 GB Linux machine. install-lite.sh appends these to .env.
# Secrets (POSTGRES_PASSWORD, BETTER_AUTH_SECRET, ...) are generated by the installer.

# Local images built from this checkout.
ARGO_IMAGE=argo/app
ARGO_IMAGE_TAG=local
ARGO_COMPUTER_IMAGE=argo/computer
ARGO_COMPUTER_IMAGE_TAG=local

# One bot computer: 1.5 GB RAM, 1.5 cores. Raise to 2g if you browse heavy sites.
ARGO_COMPUTER_MEMORY=1536m
ARGO_COMPUTER_CPUS=1.5
GRAPHILE_WORKER_CONCURRENCY=3

# Custom providers: any OpenAI-compatible server or gateway can be added in
# Settings > Models (presets: OpenRouter, Venice, Featherless, NanoGPT, Together, DeepInfra,
# Ollama, llama.cpp, LM Studio, KoboldCpp). Allow servers on this machine / LAN:
MCP_ALLOW_PRIVATE_ENDPOINT=true
ARGO_OPENAI_COMPAT_PRIVATE_HOSTS=ollama,host.docker.internal

# Optional env-configured local model provider (shows up as "Local" in the model picker).
# With --profile local-ai, Ollama runs inside the stack:
ARGO_LOCAL_MODELS=
ARGO_LOCAL_MODELS_URL=http://ollama:11434/v1
ARGO_LOCAL_CONTEXT_WINDOW=16384
ARGO_LOCAL_MAX_TOKENS=2048

# Small-model mode: give 1–3B models only the core tools so they stay accurate.
# "local" = every model on the local server; or list exact ids: qwen3:1.7b,gemma3:1b
ARGO_SMALL_MODELS=local
# ARGO_SMALL_MODEL_TOOLS=shell,read_file,write_file,web_search,web_fetch,browser_navigate,browser_snapshot,browser_act,ask_user,message_user,save_memory,recall_memory
OLLAMA_MEMORY=3g

# Memory gate: never start or wake a computer below this much free host memory (MB). 0 = off.
ARGO_MIN_FREE_MEMORY_MB=900

# Self-improvement: after a run with 3+ tool calls, the bot's model reviews the work and may
# save or update up to two "learned" skills (it never edits skills you wrote). Skipped for
# small models. Turn off with ARGO_SKILL_LEARNING=off.
ARGO_SKILL_LEARNING=on
ARGO_SKILL_LEARNING_MIN_TOOLS=3

# Coding mode: minutes of silence before a note, a second note, and stopping a hung session.
ARGO_CODING_STALL_MINUTES=10,20,40
