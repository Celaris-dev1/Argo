#!/bin/sh
# Navigator page browser: chrome-headless-shell on the same CDP port Lightpanda uses.
# No window. A second launch attaches to the one already listening.
set -eu
DISPLAY_NUM="${DISPLAY:-:1}"
DISPLAY_NUM="${DISPLAY_NUM#:}"
DISPLAY_NUM="${DISPLAY_NUM%%.*}"
case "$DISPLAY_NUM" in
  ''|*[!0-9]*) DISPLAY_NUM=1 ;;
esac
while [ "${DISPLAY_NUM#0}" != "$DISPLAY_NUM" ]; do DISPLAY_NUM="${DISPLAY_NUM#0}"; done
DISPLAY_NUM="${DISPLAY_NUM:-0}"
DEBUG_PORT="${ARGO_CDP_PORT:-$((9221 + DISPLAY_NUM))}"
URL=""
for arg in "$@"; do
  case "$arg" in
    http://*|https://*|file:*|about:*) URL="$arg" ;;
  esac
done
ready() {
  curl -sf -o /dev/null --max-time 0.4 "http://127.0.0.1:${DEBUG_PORT}/json/version"
}
started=0
if ! ready; then
  mkdir -p "$HOME/.config/argo-chrome"
  nohup /opt/chrome-headless-shell/chrome-headless-shell \
    --remote-debugging-address=127.0.0.1 --remote-debugging-port="$DEBUG_PORT" \
    --user-data-dir="$HOME/.config/argo-chrome" \
    --no-sandbox --no-first-run --no-default-browser-check --disable-dev-shm-usage \
    --disable-gpu --window-size=1280,800 --renderer-process-limit=4 \
    ${ARGO_CHROME_FLAGS:-} about:blank \
    >/tmp/argo-chrome.log 2>&1 &
  echo $! >/tmp/argo-chrome.pid
  started=1
  i=0
  while [ "$i" -lt 100 ]; do
    ready && break
    i=$((i + 1))
    sleep 0.1
  done
fi
if [ -n "$URL" ]; then
  python3 - "$DEBUG_PORT" "$URL" <<'PY'
import sys, urllib.request
port, url = sys.argv[1], sys.argv[2]
req = urllib.request.Request(
    f"http://127.0.0.1:{port}/json/new?{urllib.request.quote(url, safe='')}",
    method="PUT",
)
try:
    urllib.request.urlopen(req, timeout=3).read()
except Exception:
    sys.exit(0)
PY
fi
if [ "$started" -eq 1 ]; then
  pid="$(cat /tmp/argo-chrome.pid 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    wait "$pid"
  fi
fi
